DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/riot
PAYLOAD_SECRET=YOUR_SECRET_HERE
WORDPRESS_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
OAUTH_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY

# Google Calendar relay
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Meta / Instagram Business Discovery
META_GRAPH_VERSION=v25.0
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=

# Direct Facebook Events remains disabled until the production partner probe succeeds.
FACEBOOK_EVENTS_ENABLED=false
META_FACEBOOK_EVENT_TEST_TOKEN=
META_FACEBOOK_TEST_EVENT_ID=

# Instagram poster extraction
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17

# Comma-separated origins allowed for CORS (required when requests use credentials). Set in all environments.
# Dev example (API on :3000, app on :3001): http://localhost:3000,http://localhost:3001
# Production: https://yourapp.com,https://admin.yourapp.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
